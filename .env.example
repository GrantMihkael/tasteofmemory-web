# Server-only values. Configure these in Vercel Project Settings > Environment Variables.
# Do not prefix them with VITE_ and never commit real values.
DATABASE_URL=postgresql://postgres:your_password@localhost:3001/recipe_box
PORT=3002
APP_PASSWORD=choose_a_long_unique_password
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
# Browser-visible optional Spotify configuration.
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5174/spotify-callback
